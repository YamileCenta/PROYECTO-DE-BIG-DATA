# ===========================================================
# 1. COMPLETITUD POR CAMPO CRÍTICO
# ===========================================================
def completitud(df, columna):
    total = df.count()
    no_nulos = df.filter(F.col(columna).isNotNull()).count()
    pct = round((no_nulos / total) * 100, 2) if total > 0 else 0
    return total, no_nulos, pct

total_sis, nn_codigo, pct_codigo = completitud(df_sis, "CODIGO_ANONIMIZADO")
print(f"CODIGO_ANONIMIZADO (SIS): {pct_codigo}% completitud ({nn_codigo}/{total_sis})")

_, nn_depto, pct_depto = completitud(df_sis, "DEPARTAMENTO")
print(f"DEPARTAMENTO (SIS): {pct_depto}% completitud")

total_mimic = df_admissions.count()
nn_subject = df_admissions.filter(F.col("subject_id").isNotNull()).count()
nn_hadm = df_admissions.filter(F.col("hadm_id").isNotNull()).count()
print(f"subject_id (MIMIC-IV): {round(nn_subject/total_mimic*100,2)}% completitud")
print(f"hadm_id (MIMIC-IV): {round(nn_hadm/total_mimic*100,2)}% completitud")

# ===========================================================
# 2. COMPROBACIONES DE RANGO Y COHERENCIA
# ===========================================================
registros_edad_fuera_rango = df_sis.filter(
    (F.col("EDAD") < 0) | (F.col("EDAD") > 120)
).count()
print(f"Registros con EDAD fuera de [0,120]: {registros_edad_fuera_rango}")

registros_valor_neto_negativo = df_sis.filter(F.col("VALOR_NETO") < 0).count()
print(f"Registros con VALOR_NETO < 0: {registros_valor_neto_negativo}")

registros_atenciones_negativas = df_sis.filter(F.col("CANT_ATENCIONES") < 0).count()
print(f"Registros con CANT_ATENCIONES < 0: {registros_atenciones_negativas}")

# ===========================================================
# 3. VALIDACIÓN DE REGISTROS DE REFERENCIA MIMIC (n >= 30)
# ===========================================================
df_mimic_perfil = spark.read.parquet("hdfs://localhost:9000/consumption/metricas_perfil_mimic")
print(f"Perfiles MIMIC con soporte estadístico válido (n>=30): {df_mimic_perfil.count()}")

# ===========================================================
# RESUMEN DE CALIDAD
