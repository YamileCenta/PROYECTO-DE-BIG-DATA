## Comparativa de tamaño: Raw vs Processed/Consumption
import subprocess

comparativas = [
    {
        "nombre": "Afiliados SIS",
        "raw": "hdfs://localhost:9000/raw/afiliados/",
        "procesado": "hdfs://localhost:9000/consumption/riesgo_afiliados_sis"
    },
    {
        "nombre": "admissions",
        "raw": "hdfs://localhost:9000/raw/mimic/admissions.csv.gz",
        "procesado": "hdfs://localhost:9000/processed/mimic/admissions_limpio"
    },
    {
        "nombre": "patients",
        "raw": "hdfs://localhost:9000/raw/mimic/patients.csv.gz",
        "procesado": "hdfs://localhost:9000/processed/mimic/patients_limpio"
    },
]

def hdfs_size_mb(ruta):
    result = subprocess.run(
        ["hdfs", "dfs", "-du", "-s", ruta],
        capture_output=True, text=True
    )
    if result.returncode == 0 and result.stdout.strip():
        bytes_total = int(result.stdout.strip().split()[0])
        return round(bytes_total / (1024 * 1024), 2)
    return None

print("\n" + "="*65)
print(f"{'Dataset':<20} {'Raw (MB)':>12} {'Procesado (MB)':>16} {'Reducción':>12}")
print("="*65)

for c in comparativas:
    raw_mb = hdfs_size_mb(c["raw"])
    proc_mb = hdfs_size_mb(c["procesado"])
    if raw_mb and proc_mb and raw_mb > 0:
        reduccion = ((raw_mb - proc_mb) / raw_mb) * 100
        print(f"{c['nombre']:<20} {raw_mb:>12.2f} {proc_mb:>16.2f} {reduccion:>11.1f}%")
    else:
        print(f"{c['nombre']:<20} {'N/D':>12} {'N/D':>16} {'N/D':>12}")

print("="*65)

# Ver tamaño real descomprimido de admissions para la comparativa correcta
result = subprocess.run(
    ["bash", "-c", "zcat /datos/mimic-data/hosp/admissions.csv.gz | wc -c"],
    capture_output=True, text=True
)
bytes_desc = int(result.stdout.strip())
print(f"admissions CSV descomprimido: {round(bytes_desc / (1024*1024), 2)} MB")
print(f"admissions Parquet+Snappy:    22.36 MB")
print(f"Reducción real vs CSV crudo:  {round((1 - 22.36/(bytes_desc/1024/1024))*100, 1)}%")

