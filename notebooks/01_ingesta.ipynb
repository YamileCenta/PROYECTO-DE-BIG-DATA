import os
import findspark

os.environ["JAVA_HOME"] = "/usr/lib/jvm/java-17-openjdk-amd64"
os.environ["SPARK_HOME"] = "/opt/spark-3.5.1-bin-hadoop3"
os.environ["PYSPARK_PYTHON"] = "/home/bryanruiz/BigData_UPAO/bigdata_env/bin/python"

findspark.init()

from pyspark.sql import SparkSession
spark = SparkSession.builder.appName("IntroduccionRDDs").getOrCreate()
sc = spark.sparkContext

print("SparkSession y SparkContext iniciados con éxito. Versión de Spark:", spark.version)

# Rutas en HDFS — zona Raw
hdfs_hosp_path = "hdfs://localhost:9000/raw/mimic/"
hdfs_parquet_base = "hdfs://localhost:9000/raw/parquet/mimic/"

# Lista de las tablas seleccionadas del módulo hospitalario
tables = [
    "patients",
    "admissions",
    "diagnoses_icd",
    "d_icd_diagnoses",
    "procedures_icd",
    "d_icd_procedures",
    "drgcodes",
    "transfers",
    "labevents",
    "d_labitems"
]

for table in tables:
    print(f"Leyendo desde HDFS: {table}...")
    df = spark.read \
        .option("header", "true") \
        .option("inferSchema", "true") \
        .csv(f"{hdfs_hosp_path}{table}.csv.gz")
    
    # Registrar vista temporal para consultas SQL
    df.createOrReplaceTempView(table)
    
    # Escribir en formato optimizado Parquet
    df.write.mode("overwrite").parquet(f"{hdfs_parquet_base}{table}")
    print(f"-> Tabla '{table}' procesada y guardada en Parquet.\n")

print("¡Todas las tablas hospitalarias de MIMIC-IV han sido convertidas exitosamente!")

# Ruta del dataset de afiliados en HDFS — zona Raw
hdfs_afiliados_path = "hdfs://localhost:9000/raw/afiliados/Afiliados.csv"

print("Procesando dataset de afiliados con DM...")
df_afiliados = spark.read \
    .option("header", "true") \
    .option("inferSchema", "true") \
    .option("encoding", "UTF-8") \
    .csv(hdfs_afiliados_path)

# Registrar vista temporal para consultas SQL
df_afiliados.createOrReplaceTempView("afiliados_dm")

# Guardar en formato optimizado Parquet
df_afiliados.write.mode("overwrite").parquet("hdfs://localhost:9000/raw/parquet/afiliados_dm")
print("-> Dataset de afiliados procesado y convertido a Parquet exitosamente.")

# Mostrar una vista previa de los datos cargados
df_afiliados.show(5)
