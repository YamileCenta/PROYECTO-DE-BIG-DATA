import os
import findspark

os.environ["JAVA_HOME"] = "/usr/lib/jvm/java-17-openjdk-amd64"
os.environ["SPARK_HOME"] = "/opt/spark-3.5.1-bin-hadoop3"
os.environ["PYSPARK_PYTHON"] = "/home/bryanruiz/BigData_UPAO/bigdata_env/bin/python"

findspark.init()

from pyspark.sql import SparkSession
spark = SparkSession.builder.appName("IntroduccionRDDs").getOrCreate()
sc = spark.sparkContext

print("SparkSession y SparkContext iniciados con éxito. Versión de Spark:", spark.version)

import time
import statistics
from pyspark.sql.functions import when, col, broadcast

# ===========================================================
# PREPARACIÓN DE DATOS
# ===========================================================
df_afiliados_sis = spark.read.parquet("hdfs://localhost:9000/consumption/riesgo_afiliados_sis")
df_perfiles_mimic = spark.read.parquet("hdfs://localhost:9000/consumption/metricas_perfil_mimic")

df_afiliados_edad = df_afiliados_sis.withColumn(
    "grupo_edad_calc",
    when(col("EDAD") < 45, "18-44")
    .when((col("EDAD") >= 45) & (col("EDAD") <= 64), "45-64")
    .otherwise("65+")
)

# Renombrar para evitar ambigüedad en el join
df_perfiles_mimic_r = df_perfiles_mimic.withColumnRenamed("grupo_edad", "grupo_edad_mimic")

# ===========================================================
# PASO 1: Desactivar Broadcast automático
# ===========================================================
spark.conf.set("spark.sql.autoBroadcastJoinThreshold", -1)
print("Auto-Broadcast desactivado.")

# ===========================================================
# PASO 2: Función de medición (5 repeticiones, sin cache)
# ===========================================================
def medir_join(tipo, repeticiones=5):
    tiempos = []
    for i in range(repeticiones):
        inicio = time.perf_counter()

        if tipo == "normal":
            resultado = (
                df_afiliados_edad.join(
                    df_perfiles_mimic_r,
                    df_afiliados_edad["grupo_edad_calc"] == df_perfiles_mimic_r["grupo_edad_mimic"],
                    "inner"
                )
                .groupBy("DEPARTAMENTO", "grupo_edad_calc").count()
            )
        elif tipo == "broadcast":
            resultado = (
                df_afiliados_edad.join(
                    broadcast(df_perfiles_mimic_r),
                    df_afiliados_edad["grupo_edad_calc"] == df_perfiles_mimic_r["grupo_edad_mimic"],
                    "inner"
                )
                .groupBy("DEPARTAMENTO", "grupo_edad_calc").count()
            )

        resultado.count()
        fin = time.perf_counter()
        tiempos.append(fin - inicio)
        print(f"  {tipo} - ejecución {i+1}: {fin - inicio:.4f} segundos")

    return tiempos

# ===========================================================
# PASO 3: Ejecutar y comparar
# ===========================================================
print("\n--- JOIN Normal (SortMergeJoin forzado) ---")
tiempos_normal = medir_join("normal", 5)

print("\n--- JOIN Broadcast ---")
tiempos_broadcast = medir_join("broadcast", 5)

mediana_normal    = statistics.median(tiempos_normal)
mediana_broadcast = statistics.median(tiempos_broadcast)
mejora = ((mediana_normal - mediana_broadcast) / mediana_normal) * 100

print(f"\n{'='*45}")
print(f"  Mediana JOIN normal:      {mediana_normal:.4f} s")
print(f"  Mediana Broadcast JOIN:  {mediana_broadcast:.4f} s")
print(f"  Mejora:                  {mejora:.2f}%")
print(f"{'='*45}")

# ===========================================================
# PASO 4: Verificar planes de ejecución
# ===========================================================
print("\n📋 PLAN — JOIN Normal:")
df_afiliados_edad.join(
    df_perfiles_mimic_r,
    df_afiliados_edad["grupo_edad_calc"] == df_perfiles_mimic_r["grupo_edad_mimic"],
    "inner"
).explain("formatted")

print("\n📋 PLAN — Broadcast JOIN:")
df_afiliados_edad.join(
    broadcast(df_perfiles_mimic_r),
    df_afiliados_edad["grupo_edad_calc"] == df_perfiles_mimic_r["grupo_edad_mimic"],
    "inner"
).explain("formatted")

# ===========================================================
# RESTAURAR configuración por defecto
# ===========================================================
spark.conf.set("spark.sql.autoBroadcastJoinThreshold", 10485760)
print("\nAuto-Broadcast restaurado al valor por defecto (10 MB).")
