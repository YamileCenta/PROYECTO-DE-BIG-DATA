import time
import re
import subprocess
import traceback
from datetime import datetime
from pyspark.sql import functions as F
from pyspark.sql import DataFrame

# -----------------------------------------------------------
# CONFIGURACIÓN
# -----------------------------------------------------------

HDFS = "hdfs://localhost:9000"
RUTA_SIS_ORIGINAL = f"{HDFS}/raw/afiliados/Afiliados.csv"
RUTA_MIMIC_ORIGINAL = f"{HDFS}/raw/mimic"

RUTA_PRUEBAS = f"{HDFS}/scale_test/pipeline_completo"

ESCALAS = [10, 100]

# Reserva mínima de espacio libre para proteger el entorno.
RESERVA_BYTES = 15 * 1024**3

# Estimación conservadora: durante la ejecución pueden coexistir
# las réplicas Raw, los Parquet intermedios y los resultados finales.
FACTOR_ESPACIO = 3.0

TABLAS_MIMIC = [
    "patients",
    "admissions",
    "diagnoses_icd",
    "d_icd_diagnoses",
    "procedures_icd",
    "d_icd_procedures",
    "drgcodes",
    "transfers",
    "labevents",
    "d_labitems"
]

# Las tablas de referencia no necesitan duplicarse.
TABLAS_REFERENCIA = {
    "d_icd_diagnoses",
    "d_icd_procedures",
    "d_labitems"
}

# Resultados que permanecen en la memoria del notebook.
resultados_escalabilidad = []

def ejecutar_hdfs(args):
    """Ejecuta un comando HDFS y devuelve su salida."""
    r = subprocess.run(
        args, capture_output=True, text=True, timeout=120
    )
    if r.returncode != 0:
        raise RuntimeError(
            f"Error ejecutando {args}:\n{r.stderr}"
        )
    return r.stdout

def bytes_hdfs(ruta):
    """Obtiene el tamaño lógico informado por HDFS."""
    salida = ejecutar_hdfs(["hdfs", "dfs", "-du", "-s", ruta])
    partes = salida.split()
    if not partes:
        raise RuntimeError(f"No se pudo determinar el tamaño de {ruta}")
    return int(partes[0])

def espacio_libre_hdfs():
    salida = ejecutar_hdfs(["hdfs", "dfsadmin", "-report"])
    coincidencia = re.search(
        r"DFS Remaining:\s*([\d,]+)\s*(?:bytes)?",
        salida,
        re.IGNORECASE
    )
    if not coincidencia:
        raise RuntimeError(
            "No se pudo obtener el espacio libre de HDFS."
        )
    return int(coincidencia.group(1).replace(",", ""))

def eliminar_prueba(ruta):
    """Elimina exclusivamente la carpeta temporal indicada."""
    ejecutar_hdfs(["hdfs", "dfs", "-rm", "-r", "-f", ruta])

print("Configuración de escalabilidad cargada.")
print("Escalas previstas:", ESCALAS)
print("Ruta temporal:", RUTA_PRUEBAS)
print("Reserva mínima:", round(RESERVA_BYTES / 1024**3, 2), "GiB")

# ===========================================================
# PREVUELO — ESTIMACIÓN DE ESPACIO
# ===========================================================

try:
    tamano_sis = bytes_hdfs(RUTA_SIS_ORIGINAL)
    tamano_mimic = bytes_hdfs(RUTA_MIMIC_ORIGINAL)

    # Evitar sumar el tamaño de las tablas de MIMIC por separado:
    # usamos el directorio completo una sola vez.
    tamano_original = tamano_sis + tamano_mimic

    libre = espacio_libre_hdfs()

    print(f"Tamaño SIS:        {tamano_sis / 1024**3:.2f} GiB")
    print(f"Tamaño MIMIC-IV:  {tamano_mimic / 1024**3:.2f} GiB")
    print(f"Total original:    {tamano_original / 1024**3:.2f} GiB")
    print(f"Espacio libre:    {libre / 1024**3:.2f} GiB")

    for escala in ESCALAS:
        # Incluye Raw replicado y una estimación del espacio
        # temporal de conversión, procesamiento y consumo.
        estimacion = (
            tamano_original * escala * FACTOR_ESPACIO
        ) + RESERVA_BYTES

        if estimacion <= libre:
            print(
                f"ESCALA {escala}x: ESPACIO ESTIMADO SUFICIENTE "
                f"({estimacion / 1024**3:.2f} GiB requeridos)"
            )
        else:
            print(
                f"FALLA DE ESCALABILIDAD — ESPACIO INSUFICIENTE "
                f"PARA {escala}x. "
                f"Estimado: {estimacion / 1024**3:.2f} GiB; "
                f"disponible: {libre / 1024**3:.2f} GiB."
            )

except Exception as e:
    print("FALLA DE ESCALABILIDAD — no se pudo verificar el espacio.")
    print("Detalle:", str(e))
