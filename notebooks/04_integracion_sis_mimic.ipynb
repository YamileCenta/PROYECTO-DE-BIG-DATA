import os
import findspark

os.environ["JAVA_HOME"] = "/usr/lib/jvm/java-17-openjdk-amd64"
os.environ["SPARK_HOME"] = "/opt/spark-3.5.1-bin-hadoop3"
os.environ["PYSPARK_PYTHON"] = "/home/bryanruiz/BigData_UPAO/bigdata_env/bin/python"

findspark.init()

from pyspark.sql import SparkSession
spark = SparkSession.builder.appName("IntroduccionRDDs").getOrCreate()
sc = spark.sparkContext

print("SparkSession y SparkContext iniciados con éxito. Versión de Spark:", spark.version)

import subprocess
from pyspark.sql import functions as F

spark.sparkContext.setCheckpointDir("hdfs://localhost:9000/checkpoints")

# Releer datos limpios desde Processed
df_sis = spark.read.parquet("hdfs://localhost:9000/processed/sis/afiliados_limpio")
df_patients = spark.read.parquet("hdfs://localhost:9000/processed/mimic/patients_limpio")
df_admissions = spark.read.parquet("hdfs://localhost:9000/processed/mimic/admissions_limpio")

# --- Construcción de perfiles MIMIC (tasa de reingreso por grupo_edad y sexo) ---
df_mimic_perfil = df_patients.join(df_admissions, "subject_id") \
    .groupBy("grupo_edad","sexo_homologado") \
    .agg(
        F.count("hadm_id").alias("total_hospitalizaciones"),
        F.countDistinct("subject_id").alias("pacientes_unicos")
    ) \
    .withColumn("tasa_reingreso_promedio",
        F.col("total_hospitalizaciones") / F.col("pacientes_unicos")) \
    .filter(F.col("pacientes_unicos") >= 30)

df_mimic_perfil = df_mimic_perfil.checkpoint()

subprocess.run(["hdfs","dfs","-rm","-r","-f",
    "hdfs://localhost:9000/consumption/metricas_perfil_mimic"], capture_output=True)

df_mimic_perfil.coalesce(1).write.mode("overwrite") \
    .option("compression","snappy") \
    .parquet("hdfs://localhost:9000/consumption/metricas_perfil_mimic")
print("OK — metricas_perfil_mimic")

# --- JOIN por perfil: afiliado SIS ↔ perfil MIMIC ---
df_riesgo = df_sis.join(df_mimic_perfil, on=["grupo_edad","sexo_homologado"], how="left") \
    .withColumn("tasa_reingreso_promedio",
        F.coalesce(F.col("tasa_reingreso_promedio"), F.lit(1.0)))

df_riesgo = df_riesgo.checkpoint()

subprocess.run(["hdfs","dfs","-rm","-r","-f",
    "hdfs://localhost:9000/consumption/riesgo_afiliados_sis"], capture_output=True)

df_riesgo.coalesce(4).write.mode("overwrite") \
    .option("compression","snappy") \
    .partitionBy("DEPARTAMENTO") \
    .parquet("hdfs://localhost:9000/consumption/riesgo_afiliados_sis")
print("OK — riesgo_afiliados_sis")

subprocess.run(["hdfs","dfs","-rm","-r","-f",
    "hdfs://localhost:9000/checkpoints"], capture_output=True)
print("Checkpoints limpiados")
