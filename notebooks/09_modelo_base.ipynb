import os
import findspark

os.environ["JAVA_HOME"] = "/usr/lib/jvm/java-17-openjdk-amd64"
os.environ["SPARK_HOME"] = "/opt/spark-3.5.1-bin-hadoop3"
os.environ["PYSPARK_PYTHON"] = "/home/bryanruiz/BigData_UPAO/bigdata_env/bin/python"

findspark.init()

from pyspark.sql import SparkSession
spark = SparkSession.builder.appName("IntroduccionRDDs").getOrCreate()
sc = spark.sparkContext

print("SparkSession y SparkContext iniciados con éxito. Versión de Spark:", spark.version)

from pyspark.ml import Pipeline
from pyspark.ml.classification import LogisticRegression
from pyspark.ml.evaluation import BinaryClassificationEvaluator
from pyspark.ml.feature import StringIndexer, VectorAssembler
from pyspark.sql import functions as F
from pyspark.sql.functions import col, when
import matplotlib.pyplot as plt
import matplotlib.ticker as mticker
import numpy as np

# ===========================================================
# 4.2 — MODELO BASE: REGRESIÓN LOGÍSTICA (CON ENTRENAMIENTO Y VALIDACIÓN)
# ===========================================================

# -----------------------------------------------------------
# 1. CARGA Y PREPARACIÓN DEL DATASET
# -----------------------------------------------------------
df = spark.read.parquet("hdfs://localhost:9000/consumption/riesgo_afiliados_sis")

# Variable objetivo: reingreso = 1 si la tasa de reingreso promedio supera 1.0
df = df.withColumn(
    "label",
    when(col("tasa_reingreso_promedio") > 1.0, 1).otherwise(0).cast("double"),
)

# Codificar comorbilidades binarias (SI → 1.0, resto → 0.0)
for c in ["CON_DX_OBESIDAD", "CON_DX_HIPERTENSION", "CON_DX_SALUDMENTAL"]:
  df = df.withColumn(c + "_num", when(col(c) == "SI", 1.0).otherwise(0.0))

# Reconstruir grupo_edad_calc
df = df.withColumn(
    "grupo_edad_calc",
    when(col("EDAD") < 45, "18-44")
    .when((col("EDAD") >= 45) & (col("EDAD") <= 64), "45-64")
    .otherwise("65+"),
)

print(f"Total registros: {df.count():,}")
print("Distribución de la variable objetivo:")
df.groupBy("label").count().orderBy("label").show()

# -----------------------------------------------------------
# 2. PIPELINE DE FEATURES (con handleInvalid para robustez)
# -----------------------------------------------------------
idx_grupo_edad = StringIndexer(
    inputCol="grupo_edad_calc", outputCol="idx_grupo_edad", handleInvalid="keep"
)
idx_sexo = StringIndexer(
    inputCol="sexo_homologado", outputCol="idx_sexo", handleInvalid="keep"
)

assembler = VectorAssembler(
    inputCols=[
        "idx_grupo_edad",
        "idx_sexo",
        "CON_DX_OBESIDAD_num",
        "CON_DX_HIPERTENSION_num",
        "CON_DX_SALUDMENTAL_num",
    ],
    outputCol="features",
)

# -----------------------------------------------------------
# 3. CONFIGURACIÓN DEL MODELO CON HIPERPARÁMETROS DE ENTRENAMIENTO
# -----------------------------------------------------------
lr = LogisticRegression(
    featuresCol="features",
    labelCol="label",
    maxIter=50,
    tol=1e-6,
    regParam=0.01,
    elasticNetParam=0.0,
)

pipeline = Pipeline(stages=[idx_grupo_edad, idx_sexo, assembler, lr])

# -----------------------------------------------------------
# 4. DIVISIÓN DE DATOS: TRAIN (70%), VALIDATION (15%), TEST (15%)
# -----------------------------------------------------------
df_train, df_val, df_test = df.randomSplit([0.7, 0.15, 0.15], seed=42)
print(f"Train:      {df_train.count():,} registros")
print(f"Validation: {df_val.count():,} registros")
print(f"Test:       {df_test.count():,} registros")

# -----------------------------------------------------------
# 5. ENTRENAMIENTO Y AUDITORÍA DE CONVERGENCIA
# -----------------------------------------------------------
import time

t0 = time.perf_counter()
modelo = pipeline.fit(df_train)
t1 = time.perf_counter()
print(f"\nModelo entrenado en {t1 - t0:.2f} segundos.")

training_summary = modelo.stages[-1].summary
print(
    f"➡️ Iteraciones ejecutadas hasta convergencia:"
    f" {len(training_summary.objectiveHistory)}"
)
print(
    f"➡️ Historial de pérdida: {training_summary.objectiveHistory[:3]} ..."
    f" (Final: {training_summary.objectiveHistory[-1]:.6f})"
)

# -----------------------------------------------------------
# 6. EVALUACIÓN EN VALIDACIÓN Y TEST
# -----------------------------------------------------------
pred_val = modelo.transform(df_val)
predicciones = modelo.transform(df_test)

evaluador_roc = BinaryClassificationEvaluator(
    labelCol="label", rawPredictionCol="rawPrediction", metricName="areaUnderROC"
)
evaluador_pr = BinaryClassificationEvaluator(
    labelCol="label", rawPredictionCol="rawPrediction", metricName="areaUnderPR"
)

roc_auc_val = evaluador_roc.evaluate(pred_val)
pr_auc_val = evaluador_pr.evaluate(pred_val)
print(f"\n[Validación] PR-AUC: {pr_auc_val:.4f} | ROC-AUC: {roc_auc_val:.4f}")

roc_auc = evaluador_roc.evaluate(predicciones)
pr_auc = evaluador_pr.evaluate(predicciones)

pdf = predicciones.select("label", "prediction").toPandas()

tp = ((pdf["label"] == 1) & (pdf["prediction"] == 1)).sum()
tn = ((pdf["label"] == 0) & (pdf["prediction"] == 0)).sum()
fp = ((pdf["label"] == 0) & (pdf["prediction"] == 1)).sum()
fn = ((pdf["label"] == 1) & (pdf["prediction"] == 0)).sum()

recall = tp / (tp + fn) if (tp + fn) > 0 else 0
precision = tp / (tp + fp) if (tp + fp) > 0 else 0
f1 = (2 * precision * recall / (precision + recall)) if (precision + recall) > 0 else 0
accuracy = (tp + tn) / len(pdf)

print("\n" + "=" * 50)
print("  MÉTRICAS DEL MODELO BASE — LÍNEA BASE TÉCNICA (TEST)")
print("=" * 50)
print(f"  PR-AUC    (principal):      {pr_auc:.4f}")
print(f"  Recall    (principal):      {recall:.4f}")
print(f"  ROC-AUC   (complementaria): {roc_auc:.4f}")
print(f"  Precisión (complementaria): {precision:.4f}")
print(f"  F1-Score  (complementaria): {f1:.4f}")
print(f"  Accuracy  (referencia):     {accuracy:.4f}")
print("=" * 50)
print(f"\nMatriz de confusión (Test):")
print(f"  TP={tp:,}  FP={fp:,}")
print(f"  FN={fn:,}  TN={tn:,}")

# -----------------------------------------------------------
# 7. VISUALIZACIÓN DE MÉTRICAS
# -----------------------------------------------------------
metricas = ["PR-AUC", "Recall", "ROC-AUC", "Precisión", "F1-Score", "Accuracy"]
valores_m = [pr_auc, recall, roc_auc, precision, f1, accuracy]
colores_m = ["#e07b54", "#e07b54", "#5b8db8", "#5b8db8", "#6abf69", "#cccccc"]

fig, ax = plt.subplots(figsize=(10, 5))
bars = ax.bar(metricas, valores_m, color=colores_m, width=0.55)
ax.bar_label(bars, fmt="%.4f", padding=3, fontsize=10)
ax.set_ylim(0, 1.15)
ax.set_title("Métricas del modelo base — Regresión Logística (Línea base técnica)", fontsize=13)
ax.set_ylabel("Valor de la métrica")
ax.axhline(0.7, color="gray", linestyle="--", linewidth=0.8)
ax.grid(axis="y", linestyle="--", alpha=0.5)

from matplotlib.patches import Patch
ax.legend(
    handles=[
        Patch(color="#e07b54", label="Métricas principales"),
        Patch(color="#5b8db8", label="Métricas complementarias"),
        Patch(color="#6abf69", label="Balance precision-recall"),
        Patch(color="#cccccc", label="Referencia general"),
    ],
    loc="lower right", fontsize=9,
)
plt.tight_layout()
plt.show()

print(f"""
LÍNEA BASE TÉCNICA — MODELO BASE (Regresión Logística):
  PR-AUC:  {pr_auc:.4f}
  Recall:  {recall:.4f}

MEJORAS PREVISTAS PARA LA SEGUNDA MITAD DEL SEMESTRE:
  1. Random Forest / Gradient Boosted Trees
  2. Ajuste del umbral de clasificación para maximizar Recall
  3. Incorporación de features adicionales (CANT_ATENCIONES, VALOR_NETO, DIAS_HOSP)
  4. Balanceo de clases si el desbalance degrada el Recall
""")
