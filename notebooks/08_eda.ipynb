## Gráfico 1 — ¿Cómo se distribuyen los afiliados diabéticos por grupo etario y sexo?
import matplotlib.pyplot as plt
import matplotlib.ticker as mticker

df_edad_sexo = spark.sql("""
    SELECT grupo_edad, sexo_homologado, COUNT(*) as total
    FROM riesgo_afiliados_sis
    WHERE sexo_homologado IN ('M', 'F')
    GROUP BY grupo_edad, sexo_homologado
    ORDER BY grupo_edad
""").toPandas()

grupos  = ['18-44', '45-64', '65+']
masc    = df_edad_sexo[df_edad_sexo['sexo_homologado'] == 'M'].set_index('grupo_edad')['total'].reindex(grupos, fill_value=0)
fem     = df_edad_sexo[df_edad_sexo['sexo_homologado'] == 'F'].set_index('grupo_edad')['total'].reindex(grupos, fill_value=0)

fig, ax = plt.subplots(figsize=(9, 5))
ax.barh(grupos, [-v for v in masc], color='steelblue', label='Masculino')
ax.barh(grupos, fem,                 color='salmon',    label='Femenino')

max_val = max(masc.max(), fem.max())
ax.set_xlim(-max_val * 1.15, max_val * 1.15)
ax.xaxis.set_major_formatter(
    mticker.FuncFormatter(lambda v, _: f'{int(abs(v)):,}')
)
ax.axvline(0, color='black', linewidth=0.8)
ax.set_title('Pirámide de afiliados diabéticos por grupo etario y sexo', fontsize=13)
ax.set_xlabel('Número de afiliados')
ax.set_ylabel('Grupo etario')
ax.legend(loc='lower right')
ax.grid(axis='x', linestyle='--', alpha=0.5)
plt.tight_layout()
plt.show()

print("""
Interpretación: La pirámide muestra un perfil invertido típico de enfermedades
crónicas: la mayor concentración se encuentra en los grupos de 45-64 y 65+,
con predominio femenino en ambos. El grupo 18-44 es el menos representado,
lo que sugiere que la diabetes se diagnostica y registra principalmente en
etapas avanzadas de la vida. Para el SIS, esto implica que las intervenciones
preventivas tempranas en adultos jóvenes podrían reducir la carga futura
de complicaciones críticas.
""")

## Gráfico 2 — ¿Qué comorbilidades acompañan más frecuentemente a la diabetes?
df_comorbilidades = spark.sql("""
    SELECT
        SUM(CASE WHEN CON_DX_OBESIDAD     = 'SI' THEN 1 ELSE 0 END) as Obesidad,
        SUM(CASE WHEN CON_DX_HIPERTENSION = 'SI' THEN 1 ELSE 0 END) as Hipertension,
        SUM(CASE WHEN CON_DX_SALUDMENTAL  = 'SI' THEN 1 ELSE 0 END) as Salud_Mental,
        COUNT(*) as total
    FROM riesgo_afiliados_sis
""").toPandas()

total = df_comorbilidades['total'].values[0]
valores_abs = [
    df_comorbilidades['Obesidad'].values[0],
    df_comorbilidades['Hipertension'].values[0],
    df_comorbilidades['Salud_Mental'].values[0],
]
sin_comorbilidad = total - sum(valores_abs)
if sin_comorbilidad < 0:
    sin_comorbilidad = 0

etiquetas = ['Obesidad', 'Hipertensión', 'Salud Mental', 'Sin comorbilidad']
valores   = valores_abs + [sin_comorbilidad]
colores   = ['#e07b54', '#5b8db8', '#6abf69', '#cccccc']
explode   = [0.04, 0.04, 0.04, 0]

fig, ax = plt.subplots(figsize=(8, 6))
wedges, texts, autotexts = ax.pie(
    valores,
    labels=etiquetas,
    autopct=lambda p: f'{p:.1f}%' if p > 1 else '',
    colors=colores,
    explode=explode,
    startangle=90,
    wedgeprops=dict(width=0.5),
    textprops=dict(fontsize=11)
)
for at in autotexts:
    at.set_fontsize(10)

ax.set_title('Comorbilidades en afiliados diabéticos del SIS', fontsize=13, pad=20)
leyenda = [f'{e}: {int(v):,}' for e, v in zip(etiquetas, valores)]
ax.legend(leyenda, loc='lower center', bbox_to_anchor=(0.5, -0.12),
          ncol=2, fontsize=9)
plt.tight_layout()
plt.show()

print(f"""
Interpretación: La hipertensión es la comorbilidad más prevalente entre los
afiliados diabéticos del SIS, seguida de obesidad y problemas de salud mental.
La mayoría no tiene ninguna de estas tres comorbilidades registradas, lo que
puede reflejar subdiagnóstico más que ausencia real de la condición.
""")

## Gráfico 3 — ¿Cuál es la tasa de reingreso promedio por grupo etario y sexo?
import numpy as np

df_perfil = spark.sql("""
    SELECT grupo_edad, sexo_homologado,
           ROUND(tasa_reingreso_promedio, 2) as tasa
    FROM metricas_perfil_mimic
    ORDER BY grupo_edad, sexo_homologado
""").toPandas()

pivot = df_perfil.pivot(index='grupo_edad', columns='sexo_homologado', values='tasa')
pivot = pivot.reindex(['18-44', '45-64', '65+'])

fig, ax = plt.subplots(figsize=(6, 4))
im = ax.imshow(pivot.values.astype(float), cmap='YlOrRd', aspect='auto')

ax.set_xticks(range(len(pivot.columns)))
ax.set_xticklabels(
    ['Femenino' if c == 'F' else 'Masculino' for c in pivot.columns],
    fontsize=11
)
ax.set_yticks(range(len(pivot.index)))
ax.set_yticklabels(pivot.index, fontsize=11)

for i in range(len(pivot.index)):
    for j in range(len(pivot.columns)):
        val = pivot.values[i, j]
        if not np.isnan(val):
            ax.text(j, i, f'{val:.2f}',
                    ha='center', va='center',
                    fontsize=13, fontweight='bold',
                    color='black')

plt.colorbar(im, ax=ax, label='Hospitalizaciones promedio por paciente')
ax.set_title('Tasa de reingreso por grupo etario y sexo\n(referencia MIMIC-IV)', fontsize=12)
plt.tight_layout()
plt.show()

print("""
Interpretación: El mapa de calor confirma que la tasa de reingreso hospitalario
crece con la edad en ambos sexos, siendo el grupo 65+ el de mayor riesgo.
Las celdas más oscuras identifican los perfiles clínicos que el modelo debe
priorizar al asignar alertas preventivas a los afiliados del SIS.
""")
