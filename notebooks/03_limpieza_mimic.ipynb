import os
import findspark

os.environ["JAVA_HOME"] = "/usr/lib/jvm/java-17-openjdk-amd64"
os.environ["SPARK_HOME"] = "/opt/spark-3.5.1-bin-hadoop3"
os.environ["PYSPARK_PYTHON"] = "/home/bryanruiz/BigData_UPAO/bigdata_env/bin/python"

findspark.init()

from pyspark.sql import SparkSession
spark = SparkSession.builder.appName("IntroduccionRDDs").getOrCreate()
sc = spark.sparkContext

print("SparkSession y SparkContext iniciados con éxito. Versión de Spark:", spark.version)

import subprocess
from pyspark.sql import functions as F

# Configurar directorio de checkpoint en HDFS
spark.sparkContext.setCheckpointDir("hdfs://localhost:9000/checkpoints")

# --- admissions ---
df_admissions = spark.read.option("header","true").option("inferSchema","true") \
    .csv("hdfs://localhost:9000/raw/mimic/admissions.csv.gz") \
    .dropDuplicates(["subject_id","hadm_id"]) \
    .withColumn("admittime", F.to_timestamp("admittime")) \
    .withColumn("dischtime", F.to_timestamp("dischtime"))

df_admissions = df_admissions.checkpoint()

subprocess.run(["hdfs","dfs","-rm","-r","-f",
    "hdfs://localhost:9000/processed/mimic/admissions_limpio"], capture_output=True)

df_admissions.coalesce(1).write.mode("overwrite") \
    .option("compression","snappy") \
    .parquet("hdfs://localhost:9000/processed/mimic/admissions_limpio")
print("OK — admissions_limpio")

# --- patients ---
df_patients = spark.read.option("header","true").option("inferSchema","true") \
    .csv("hdfs://localhost:9000/raw/mimic/patients.csv.gz") \
    .filter((F.col("anchor_age") >= 0) & (F.col("anchor_age") <= 120)) \
    .withColumn("grupo_edad",
        F.when(F.col("anchor_age").between(18,44),"18-44")
         .when(F.col("anchor_age").between(45,64),"45-64")
         .otherwise("65+")) \
    .withColumn("sexo_homologado", F.upper(F.col("gender")))

df_patients = df_patients.checkpoint()

subprocess.run(["hdfs","dfs","-rm","-r","-f",
    "hdfs://localhost:9000/processed/mimic/patients_limpio"], capture_output=True)

df_patients.coalesce(1).write.mode("overwrite") \
    .option("compression","snappy") \
    .parquet("hdfs://localhost:9000/processed/mimic/patients_limpio")
print("OK — patients_limpio")

# Limpiar checkpoints
subprocess.run(["hdfs","dfs","-rm","-r","-f",
    "hdfs://localhost:9000/checkpoints"], capture_output=True)
print("Checkpoints limpiados")
