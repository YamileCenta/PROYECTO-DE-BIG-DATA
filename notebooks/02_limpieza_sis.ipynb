import os
import findspark

os.environ["JAVA_HOME"] = "/usr/lib/jvm/java-17-openjdk-amd64"
os.environ["SPARK_HOME"] = "/opt/spark-3.5.1-bin-hadoop3"
os.environ["PYSPARK_PYTHON"] = "/home/bryanruiz/BigData_UPAO/bigdata_env/bin/python"

findspark.init()

from pyspark.sql import SparkSession
spark = SparkSession.builder.appName("IntroduccionRDDs").getOrCreate()
sc = spark.sparkContext

print("SparkSession y SparkContext iniciados con éxito. Versión de Spark:", spark.version)

from pyspark.sql import functions as F

# 1. CARGA Y VERIFICACIÓN DE ESQUEMA

df_sis = spark.read.option("header", "true").option("inferSchema", "true") \
    .option("encoding", "UTF-8") \
    .csv("hdfs://localhost:9000/raw/afiliados/Afiliados.csv")

df_patients = spark.read.option("header", "true").option("inferSchema", "true") \
    .csv("hdfs://localhost:9000/raw/mimic/patients.csv.gz")

df_admissions = spark.read.option("header", "true").option("inferSchema", "true") \
    .csv("hdfs://localhost:9000/raw/mimic/admissions.csv.gz")

df_diag = spark.read.option("header", "true").option("inferSchema", "true") \
    .csv("hdfs://localhost:9000/raw/mimic/diagnoses_icd.csv.gz")

df_sis.printSchema()
df_admissions.printSchema()
df_sis.show(5)

# 2. NULOS, DUPLICADOS Y ATÍPICOS
# ===========================================================
# Nulos — SIS: filtro estricto en la variable geográfica
df_sis = df_sis.filter(F.col("DEPARTAMENTO").isNotNull())
# Nulos — MIMIC: dischtime/dod se conservan (pacientes activos/vivos), sin acción

# Duplicados
df_sis = df_sis.dropDuplicates(["CODIGO_ANONIMIZADO"])
df_admissions = df_admissions.dropDuplicates(["subject_id", "hadm_id"])

# Atípicos — rango biológico de edad en ambas bases
df_sis = df_sis.filter((F.col("EDAD") >= 0) & (F.col("EDAD") <= 120))
df_patients = df_patients.filter((F.col("anchor_age") >= 0) & (F.col("anchor_age") <= 120))

# 3. CORRECCIÓN DE TIPOS Y NORMALIZACIÓN DE FORMATOS
# ===========================================================
df_admissions = df_admissions \
    .withColumn("admittime", F.to_timestamp("admittime")) \
    .withColumn("dischtime", F.to_timestamp("dischtime"))

for c in ["DEPARTAMENTO", "SEXO", "TIPO_DIABETES"]:
    df_sis = df_sis.withColumn(c, F.upper(F.trim(F.col(c))))

# 4. INGENIERÍA DE CARACTERÍSTICAS
# ===========================================================
# grupo_edad — SIS
df_sis = df_sis.withColumn(
    "grupo_edad",
    F.when(F.col("EDAD").between(18, 44), "18-44")
     .when(F.col("EDAD").between(45, 64), "45-64")
     .otherwise("65+")
)

# grupo_edad — MIMIC
df_patients = df_patients.withColumn(
    "grupo_edad",
    F.when(F.col("anchor_age").between(18, 44), "18-44")
     .when(F.col("anchor_age").between(45, 64), "45-64")
     .otherwise("65+")
)

# sexo_homologado
df_sis = df_sis.withColumn(
    "sexo_homologado",
    F.when(F.col("SEXO") == "MASCULINO", "M")
     .when(F.col("SEXO") == "FEMENINO", "F")
     .otherwise(F.col("SEXO"))
)
df_patients = df_patients.withColumn(
    "sexo_homologado", F.upper(F.col("gender"))
)

# Guardar SIS limpio en Processed
df_sis.write.mode("overwrite") \
    .option("compression", "snappy") \
    .parquet("hdfs://localhost:9000/processed/sis/afiliados_limpio")

print("SIS limpio guardado en /processed/sis/afiliados_limpio")
